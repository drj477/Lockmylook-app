# App
APP_NAME=LockMyLook
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+psycopg://lockmylook:lockmylook_dev@127.0.0.1:5432/lockmylook

# JWT - replace these values for any shared/staging/production environment
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Virtual Try-On
# Replicate provider (existing production path).
REPLICATE_API_TOKEN=

# Gemini image provider (optional until enabled for testing).
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_IMAGE_SIZE=2K

# Logging
LOG_LEVEL=INFO
