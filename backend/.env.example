# App
APP_NAME=LockMyLook
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+psycopg://lockmylook:lockmylook_dev@127.0.0.1:5432/lockmylook

# JWT - generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Virtual Try-On
# Existing production provider.
REPLICATE_API_TOKEN=

# Direct Pruna P-Image-Try-On provider (D-Tryon).
PRUNA_API_KEY=
# Public HTTPS base URL that Pruna can use to fetch /uploads/ images.
# Local testing can use a temporary HTTPS tunnel; production should use the backend's public HTTPS URL.
PRUNA_PUBLIC_BASE_URL=

# Existing Gemini image provider.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_IMAGE_SIZE=2K

# Experimental Gemini Chat provider. Keep the cookie JSON outside Git.
# Example: secrets/gemini-cookies.json
GEMINI_CHAT_COOKIE_JSON=
GEMINI_CHAT_COOKIE_CACHE_DIR=secrets/gemini_webapi
GEMINI_CHAT_TIMEOUT_SECONDS=450

# Logging
LOG_LEVEL=INFO
